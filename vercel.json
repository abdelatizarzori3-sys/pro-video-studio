{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm exec vite build",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/manus-storage/:path*",
      "destination": "/api/manus-storage/:path*"
    }
  ]
}
